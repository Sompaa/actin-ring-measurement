{
 "_comment": "TopoActin V3 settings for re-running the BasR vs KpSen paper plates, calibrated against the January 2026 results (see README, 'Settings used' and 'How the settings were established').",
 "brightness_contrast": {
  "actin": {
   "brightness": 1.4,
   "contrast": 1.75,
   "gamma": 1.0
  },
  "nuclei": {
   "brightness": 1.4,
   "contrast": 1.3,
   "gamma": 1.0
  }
 },
 "image_normalization": {
  "_comment": "Image-level CLAHE applied to the full actin MIP after B/C, before skeletonization. Affects skeleton topology AND weighted density metrics (Path C). Set use_clahe:true to enable.",
  "use_clahe": false,
  "clahe_clip_limit": 0.03,
  "clahe_tile_grid_size": [
   8,
   8
  ]
 },
 "segmentation": {
  "cell": {
   "diameter": 0,
   "flow_threshold": 0.4,
   "cellprob_threshold": 0.0,
   "min_size": 200
  },
  "nucleus": {
   "diameter": 0,
   "flow_threshold": 0.4,
   "cellprob_threshold": 0.0,
   "min_size": 80
  }
 },
 "nucleus_filtering": {
  "min_area": 250,
  "max_area": 5000,
  "min_solidity": 0.82,
  "max_eccentricity": 0.85,
  "min_eccentricity": 0.0,
  "min_roundness": 0.55,
  "min_mean_intensity": 0.1,
  "max_intensity_std": 1.5,
  "rescue_phenotype_exclusions": false,
  "rescue_solidity_threshold": 0.6,
  "rescue_eccentricity_threshold": 0.95,
  "proximity_exclusion": {
   "enabled": false,
   "dilation_pixels": 10
  }
 },
 "cell_filtering": {
  "min_area": 500,
  "max_area": 400500,
  "min_solidity": 0.7,
  "max_eccentricity": 0.95,
  "reject_multiple_nuclei": true,
  "border_buffer": 20,
  "require_valid_nucleus": true
 },
 "skeletonization": {
  "gaussian_sigma": 0.7,
  "sato_sigmas": [
   0.7,
   0.96,
   1.22,
   1.48,
   1.74,
   2.0
  ],
  "processing_mode": "2d",
  "min_branch_length": 5.0,
  "binary_threshold_percentile": 75.0,
  "use_automatic_threshold": true,
  "automatic_threshold_method": "li",
  "use_hysteresis_threshold": true,
  "hysteresis_low_fraction": 0.4,
  "use_clahe": false,
  "clahe_clip_limit": 0.01,
  "min_object_size": 3,
  "closing_radius": 1,
  "opening_radius": 0,
  "fill_holes": false,
  "dilation_radius": 0,
  "erosion_radius": 0,
  "calculate_fidelity_metric": true,
  "calculate_weighted_skeleton_metrics": true,
  "sato_black_ridges": false
 },
 "vieira_preprocessing": {
  "enable": false,
  "sigma": 0.0,
  "adaptive": false
 },
 "dual_path_processing": {
  "enable": true,
  "use_3d_filtering": true,
  "path_a_reference": "mip",
  "path_b_structure": "sato"
 },
 "cortical_analysis": {
  "erosion_pixels": 5,
  "use_sato_for_intensity": true,
  "min_cortical_area": 40
 },
 "topological_analysis": {
  "n_zones": 3,
  "inner_threshold": 0.33,
  "mid_threshold": 0.66,
  "min_cortical_pixels": 30,
  "min_skeleton_coverage": 0.02,
  "min_angular_bins_filled": 6
 },
 "processing": {
  "save_masks": false,
  "save_skeletons": true,
  "save_comparisons": true,
  "save_polar_maps": true,
  "use_gpu": true,
  "batch_size": 8
 },
 "visualization": {
  "experiment_level_only": true
 },
 "batch_mode": false,
 "bacterial_burden": {
  "enabled": false
 },
 "downsampling": {
  "enabled": false,
  "_comment": "Do not use: seed 42 does not regenerate the paper fields. Use prepare_input.py with a field list instead."
 },
 "z_projection": {
  "method": "mip",
  "use_for_segmentation": true,
  "keep_3d_volume": true
 },
 "well_to_group": {
  "3": "KpSen",
  "4": "KpSen",
  "5": "KpSen",
  "6": "KpSen",
  "7": "BasR",
  "8": "BasR",
  "9": "BasR",
  "10": "BasR",
  "2": "Control",
  "11": "Control"
 },
 "group_colors": {
  "BasR": "green",
  "Control": "blue",
  "KpSen": "red"
 }
}